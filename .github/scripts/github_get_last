#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: $0 --type tag|release --repo https://github.com/OWNER/REPOSITORY.git [--github-token TOKEN]" >&2
  exit 2
}

type=""
repo=""
github_token=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --type)
      [ "$#" -ge 2 ] || usage
      type="$2"
      shift 2
      ;;
    --repo)
      [ "$#" -ge 2 ] || usage
      repo="$2"
      shift 2
      ;;
    --github-token)
      [ "$#" -ge 2 ] || usage
      github_token="$2"
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

case "$type" in
  tag)
    endpoint="tags?per_page=1"
    query='.[0].name'
    ;;
  release)
    endpoint="releases/latest"
    query='.tag_name'
    ;;
  *)
    usage
    ;;
esac

repository="${repo#https://github.com/}"
repository="${repository%.git}"
if [ -z "$repo" ] || [ "$repository" = "$repo" ] || ! [[ "$repository" =~ ^[^/]+/[^/]+$ ]]; then
  echo "Invalid GitHub repository URL: $repo" >&2
  exit 2
fi

headers=(
  -H "Accept: application/vnd.github+json"
  -H "X-GitHub-Api-Version: 2022-11-28"
)
if [ -n "$github_token" ]; then
  headers+=(-H "Authorization: Bearer $github_token")
fi

curl --fail --silent --show-error --location "${headers[@]}" \
  "https://api.github.com/repos/$repository/$endpoint" | yq -er "$query"

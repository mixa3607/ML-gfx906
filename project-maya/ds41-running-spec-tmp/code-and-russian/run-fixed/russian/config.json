{
  "exe": "/opt/maya/build-hip/maya-ds4",
  "cwd": "/opt/maya",
  "backend": "hip",
  "gpu": [
    0,
    1,
    2,
    3
  ],
  "model_name": "deepseek-v4.1-flash",
  "tokenizer": "/data/ds4/tokenizer",
  "log": "/data/screen/russian/engine.log",
  "lib_dirs": [
    "/opt/rocm/lib"
  ],
  "args": [
    "--pack",
    "/data/ds4",
    "--gpus",
    "0,1,2,3",
    "--max-context",
    "196608",
    "--tp",
    "4",
    "--cpu-threads",
    "56",
    "--prefill-chunk",
    "2048",
    "--reserve-mib",
    "1280",
    "--mmap-experts",
    "off",
    "--dspark",
    "on",
    "--dspark-conf",
    "0.5",
    "--vision",
    "on",
    "--expert-profile",
    "/data/screen/russian/expert-profile.bin"
  ],
  "env": {
    "LD_LIBRARY_PATH": "/opt/rocm/lib",
    "HIP_VISIBLE_DEVICES": "0,1,2,3",
    "DS4_RING_MB": "400",
    "DS4_ENGRAM_CACHE_MB": "256",
    "DS4_HIP_ATTN_SWIZZLE": "1",
    "STRATA_DS4_RAM_TIER": "0",
    "STRATA_DS4_DISK_SKIP_W": "0",
    "STRATA_DS4_PROMPT_SKIP": "0",
    "STRATA_DS4_SLOT_KEEP": "0",
    "DS4_COPY_NUMA": "2",
    "DS4_TP_GGUF_UNEVEN": "1",
    "DS4_DRAFT_DEV": "1,2,3",
    "STRATA_DS4_DSPARK_CUM": "0.5",
    "DS4_DSPARK_MAX": "0"
  }
}

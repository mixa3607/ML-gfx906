{
  "exe": "/opt/maya/build-hip/maya-ds4",
  "cwd": "/opt/maya",
  "args": [
    "--pack",
    "/data/ds4",
    "--gpus",
    "0,1,2,3",
    "--max-context",
    "196608",
    "--tp",
    "4",
    "--cpu-threads",
    "56",
    "--prefill-chunk",
    "2048",
    "--reserve-mib",
    "512",
    "--mmap-experts",
    "off",
    "--dspark",
    "on",
    "--dspark-conf",
    "0.5",
    "--vision",
    "on",
    "--expert-profile",
    "/data/runs/prune-on-check/expert-profile.bin",
    "--no-expert-cache"
  ],
  "env": {
    "LD_LIBRARY_PATH": "/opt/rocm/lib",
    "HIP_VISIBLE_DEVICES": "0,1,2,3",
    "DS4_RING_MB": "400",
    "DS4_ENGRAM_CACHE_MB": "256",
    "DS4_HIP_ATTN_SWIZZLE": "1",
    "DS4_COPY_NUMA": "2",
    "DS4_TP_GGUF_UNEVEN": "1",
    "DS4_DRAFT_DEV": "1,2,3",
    "DS4_DSPARK_MAX": "0",
    "MAYA_DS4_RAM_TIER": "0",
    "MAYA_DS4_DISK_SKIP_W": "0",
    "MAYA_DS4_PROMPT_SKIP": "0",
    "MAYA_DS4_SLOT_KEEP": "0",
    "MAYA_DS4_DSPARK_CUM": "0.5",
    "DS4_SKIP_UNPICKED": "1",
    "DS4_TP_CHECK": "1",
    "DS4_CHECK_SWAPS": "1",
    "DS4_PROF": "1",
    "DS4_PREFILL_STATS": "1",
    "DS4_FLOW_STATS": "1",
    "DS4_SERVE_DUMP": "/data/runs/prune-on-check/logits"
  },
  "tokenizer": "/data/ds4/tokenizer"
}

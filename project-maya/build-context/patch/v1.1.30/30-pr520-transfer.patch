+                     dh = gg::type_row_bytes(gg::expert_type(l.lay, 2), x.ffn);
+        const int nr = g.dim / NH;
+        for (int X = 0; X < NH; ++X) {
+            const uint8_t* p = mx_part_ptr(l, e, 2, X) + d0;
+            uint8_t* q = dst + (size_t) X * (size_t) nr * dh;

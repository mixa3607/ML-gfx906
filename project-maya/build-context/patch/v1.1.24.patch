diff --git a/cmake/hip_backend.cmake b/cmake/hip_backend.cmake
--- a/cmake/hip_backend.cmake
+++ b/cmake/hip_backend.cmake
@@ -17,5 +17,5 @@
 # gfx908 (AMD Instinct MI100, CDNA1) is wave64, not wave32: it runs through the hip_compat layer's logical-32-lane
 # half-wavefront warp mapping (see hip_compat/intrinsics.hpp). Experimental; validated on a 4x MI100 box.
-set(_strata_hip_wave64 gfx908)
+set(_strata_hip_wave64 gfx906 gfx908)
 # CMake hands HIP a ';' list, but a -DCMAKE_HIP_ARCHITECTURES typed by hand (or ROCm's own Windows tooling) may use
 # spaces, which foreach(IN LISTS) would otherwise treat as one element.
diff --git a/include/strata/hip_compat/intrinsics.hpp b/include/strata/hip_compat/intrinsics.hpp
--- a/include/strata/hip_compat/intrinsics.hpp
+++ b/include/strata/hip_compat/intrinsics.hpp
@@ -29,5 +29,5 @@
     return __builtin_amdgcn_sdot4(a, b, c, false);
-#elif defined(__gfx908__) && __has_builtin(__builtin_amdgcn_sdot4)
-    // CDNA1 (MI100): v_dot4_i32_i8, the same signed dot4 the wave64 compat layer relies on.
+#elif (defined(__gfx906__) || defined(__gfx908__)) && __has_builtin(__builtin_amdgcn_sdot4)
+    // Vega20 / CDNA1: signed dot4, with wrapping accumulation (no clamp).
     return __builtin_amdgcn_sdot4(a, b, c, false);
 #elif defined(__gfx1012__) && !defined(STRATA_GFX1012_PORTABLE_DOT)
diff --git a/maya.py b/maya.py
--- a/maya.py
+++ b/maya.py
@@ -94,4 +94,4 @@
                                                    # only when such a GPU is chosen
-HIP_ARCHS_WAVE64 = ("gfx908",)                      # CDNA 1 (AMD Instinct MI100): wave64, runs through the hip_compat
+HIP_ARCHS_WAVE64 = ("gfx906", "gfx908")             # Vega20 / CDNA1: wave64, runs through the hip_compat
                                                    # layer's logical-32-lane half-wavefront warp mapping; experimental
 PY_PACKAGES = list(S.PY_PACKAGES)                  # (pillow: pictures in formats other than JPEG/PNG/BMP/GIF)
diff --git a/src/kernels/cuda/glm_lat8.cuh b/src/kernels/cuda/glm_lat8.cuh
--- a/src/kernels/cuda/glm_lat8.cuh
+++ b/src/kernels/cuda/glm_lat8.cuh
@@ -28,5 +28,6 @@
     const __half2 a = __hmul2(__hsub2(*(const __half2*) &lo, bias), d);
     const __half2 b = __hmul2(__hsub2(*(const __half2*) &hi, bias), d);
-#if defined(STRATA_USE_HIP)
+    // Vega20's F32 reference preserves -0, as does its native FP16 product.
+#if defined(STRATA_USE_HIP) && !defined(__gfx906__)
     // a code 0 times a negative scale is -0 in FP16 and +0 through AMD's F32 product: a zero half loses its sign
     // (only a code 0 makes a zero here - a normal scale times any other code is a normal number)

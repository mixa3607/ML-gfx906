DeepSeek-V4-Flash-Vision-orcarouter:
  enabled: true
  load-on-startup: false
  load-mode: mlock
  hf-repo: orcarouter/DeepSeek-V4-Flash-Vision-Uncensored-GGUF
  mmproj: /root/.cache/huggingface/hub/models--unsloth--DeepSeek-V4-Flash-Vision-Exp-GGUF/snapshots/87ce15810931a270f165e5e50439cd446f6b4ba5/mmproj-F16.gguf
  cache-ram: 32768
  ctx-size: 131072
  temp: "1.0"
  top-p: "1.0"
  min-p: "0.01"
  spec:
    type: none
  device: [ ROCm0, ROCm1, ROCm2, ROCm3 ]
  threads: 32
  main-gpu: 0
  n-gpu-layers: all
  split-mode: layer
  tensor-split: [ 25, 25, 25, 25 ]
  override-tensor:
    - target: CPU
      tensors:
        - blk.0.ffn_(up|down)_exps.weight
        - blk.1.ffn_(up|down)_exps.weight
        - blk.2.ffn_(up|down)_exps.weight
        - blk.3.ffn_(up|down)_exps.weight
        - blk.4.ffn_(up|down)_exps.weight
        - blk.5.ffn_(up|down)_exps.weight
    - target: CPU
      tensors:
        - blk.11.ffn_(up|down)_exps.weight
        - blk.12.ffn_(up|down)_exps.weight
        - blk.13.ffn_(up|down)_exps.weight
        - blk.14.ffn_(up|down)_exps.weight
        - blk.15.ffn_(up|down)_exps.weight
        - blk.16.ffn_(up|down)_exps.weight
    - target: CPU
      tensors:
        - blk.22.ffn_(up|down)_exps.weight
        - blk.23.ffn_(up|down)_exps.weight
        - blk.24.ffn_(up|down)_exps.weight
        - blk.25.ffn_(up|down)_exps.weight
        - blk.26.ffn_(up|down)_exps.weight
        - blk.27.ffn_(up|down)_exps.weight
    - target: CPU
      tensors:
        - blk.33.ffn_(up|down)_exps.weight
        - blk.34.ffn_(up|down)_exps.weight
        - blk.35.ffn_(up|down)_exps.weight
        - blk.36.ffn_(up|down)_exps.weight
        - blk.37.ffn_(up|down)_exps.weight
  child-wrapper:
    env:
      LLAMA_ARG_LOG_VERBOSITY: "4"
      HIP_VISIBLE_DEVICES: null
    command: "numactl --interleave=all {exe} {args}"
